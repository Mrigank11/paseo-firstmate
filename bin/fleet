#!/usr/bin/env bash
# bin/fleet — the ONLY writer of state/fleet.json.
#
# Every fleet write goes through this helper. It validates the state/shape
# enums and the ask length cap, then writes atomically (temp file +
# rename) so a crash or truncated edit can never corrupt the file.
# Reads (get, by-agent, active, asks) are plain jq and never mutate.
#
# fleet.json is v2: {"version": 2, "tasks": [...]}. A task holds the first mate's INTENT (`state`), never run state:
# what the crew is doing comes from Paseo (agents labelled fm.task=<id>) and is computed (`bin/fleet stage`). A file
# without "version": 2 is refused for writes ("run bin/migrate-fleet-v2"); reads still work. See docs/STATE.md.
#
#   bin/fleet get <id>                print one task entry (compact JSON)
#   bin/fleet by-agent <agentId>      the entry of the task an agent works on: its fm.task label first, then the archive
#                                     (agents/agentId lists). Prints nothing for an agent that is not crew
#   bin/fleet stage <id>              the task's COMPUTED stage (JSON): {stage, group, owner, reason, clears, agentId, flags,
#                                     source}. The deck plugin's snapshot (state/stages.json, the page's own evaluation) when
#                                     fresh, else computed locally and marked source:"local" (degraded: no comments, no last
#                                     messages); owner is who owes the next move; a flag with drift:true means the registry
#                                     and Paseo disagree
#   bin/fleet stages [--project <p>] [--table]   the same for every live task, in one pass
#   bin/fleet active [--project <p>]  live entries with state=active: id, state, since, project
#   bin/fleet project <p>             every LIVE task of project <p>, any state (compact JSON, one per line)
#   bin/fleet project <p> --archive [N]   last N (default 30) archive lines for project <p>
#   bin/fleet asks                    every open ask across live tasks
#   bin/fleet add <id> k=v ...        create a task (needs intent, shape, state; optional canvas_kind=issue|plan|research|explainer|review,
#                                     absent = issue); stamps since
#   bin/fleet set <id> k=v ...        update scalar fields
#   bin/fleet ask <id> "<text>" [--context-file <path>] [--options "A|B|C"] [--ref <json>]
#                                     append {id, text, since} to asks. The id ("a1", "a2", ...) is stable: assigned
#                                     here, never reused for that task, kept by reask/pending/answer. The file is copied
#                                     to tasks/<id>/asks/<n>.md and linked as "context". --options
#                                     (2-6 choices, each <=60 chars, "|" separated) stores
#                                     options:[..]; the page shows them as buttons. --ref (Phase 5) is
#                                     {"kind":"canvas","agentId":"..","block":".."}: the ask lives in a canvas
#   bin/fleet reask <id> <ask> ["<new text>"] [--context-file <path>] [--options "A|B|C"]
#                                     reset ask n's "since" to now (back to Needs you on the page after
#                                     the captain's follow-up was answered); optionally replace its text
#                                     (<=200 chars), context file and options, the way ask does
#                                     (options are kept when --options is absent)
#                                     The context file of an ISSUE task (canvas_kind=issue, or none) must hold these headings in this
#                                     order (the canvas structure, see ask-template) or ask/reask refuse and list what is missing or out
#                                     of order. A task with canvas_kind plan|research|explainer|review is free form: no heading check
#   bin/fleet ask-template [<id>]     (no id, or an issue task: the seven headings; any other canvas_kind: a free-form note, no check)
#                                     print the context-file skeleton (BLUF, Issue, Impact, Context and components,
#                                     Changes by component, Fix plan, Ask) to fill in and pass as --context-file
#   bin/fleet pending <id> <ask>      mark the ask as waiting on the first mate's follow-up (sets pendingSince):
#                                     the page keeps it under "With the first mate" instead of Needs you.
#                                     reask and answer clear it. `bin/page reply ... --followup <id>:<ask>` calls this
#   bin/fleet depend <id> <dep-id>... append to depends_on (de-duplicated; deps may be archived ids)
#   bin/fleet undepend <id> <dep-id>  remove one id from depends_on
#   bin/fleet answer <id> <ask>       resolve (remove) the ask, by stable id (a2) or by 1-based index
#   bin/fleet preview <id> <port> <pid>   record a crew preview server (tasks/<id>/preview.json, not the registry)
#   bin/fleet clear-preview <id>      drop the preview record (after killing it)
#   bin/fleet log <id> "<text>"       append a timestamped line to tasks/<id>/log.md
#   bin/fleet archive <id>            move a done/failed ask-free task to the archive (the line adds agents:[ids], outcome)
#   bin/fleet card <id> (--file <f>|-)  write tasks/<id>/card.md (the Markdown card the page shows) from a file or stdin; works for
#                                     a live or an archived task; a no-op when the content is already there
#   bin/fleet archive-update <id> k=v ...   append an updated copy of an ARCHIVED task (same keys as set, plus depends_on=a,b): the
#                                     archive stays append-only and the newest line for an id wins. For tasks archived before
#                                     they had a project/title
#   bin/fleet finish <id> [--failed] [--card -|--card-file <f>] [--branch <b>] [--base main] [--close-asks|--answer <ask>...]
#                                     a crew member is done: state=done (failed with --failed); REFUSES while the task has open
#                                     asks, unless the same command answers them (--close-asks answers all, --answer a1 one,
#                                     repeatable): a finished task must not leave answered questions open. Records the task's
#                                     agent ids (label fm.task) for the archive. Writes tasks/<id>/card.md from
#                                     the given card (stdin with -), else from the intent + branch/PR when there is no card yet; for
#                                     a project task whose branch is known and whose project.json has a repo, appends
#                                     `git log --oneline <base>..<branch>` to projects/<p>/sections/code.md (dated, no duplicates)
#   bin/fleet children <id>           the direct children of a group (JSON array of {id, kind, state, title})
#   bin/fleet tree [<project>]        the live tasks as an indented tree (registry facts only; `rollup` has the computed stage)
#   bin/fleet rollup <id> [--markdown]  a group's computed stage: the most urgent leaf stage, counts, each child's stage (node + the
#                                     plugin's snapshot, like `stage`). --markdown prints the card text rebuilt from the children
#   bin/fleet group-card <id>         write tasks/<id>/card.md from the rollup (the group's card, rebuilt from its children)
#   bin/fleet claim-node <id> <agentId> [--replace]   a second mate takes a group (tasks/<id>/claim.json). Only the first mate
#                                     claims; a node's second mate never claims or releases (PASEO_AGENT_ID is checked)
#   bin/fleet release-node <id>       the first mate retires a second mate (removes the claim); refused for the claim's own agent
#
# Task tree: `parent=<group-id>` (optional) hangs a task under a group, `kind=group` makes a task a group (no crew of its own).
# A parent is a live group of the same project; at most two ancestors (project > group > group > task), no cycles. A task with no
# parent is top-level, exactly as before. A child with no project= inherits its parent's. A group is not archived or finished while
# a descendant is open. A second mate (PASEO_AGENT_ID equal to a node claim) may write only inside that node's subtree (and log,
# card and ask on the node itself); every other agent is unrestricted, as before. See docs/STATE.md.
#
# States: queued (planned), active (dispatched; Paseo says what is happening), parked (the captain paused it), blocked
# (waiting on an outside dependency, not the captain, not crew; REQUIRES blocked_on="<what/who>", <=200 chars; dropped when
# the state moves off blocked), done / failed (the first mate's verdict after harvest).
# Run-state keys are refused with a pointer: status, agentId, workspaceId, lastEvent, notes, preview, provider.
# Optional fields (add/set): project (kebab slug, empty = none), title (<=160 chars), order (integer: position on the
# page within a group, lowest first; tasks without one keep file order), legacyId (kebab slug: the id the task had on a
# hand-run page it was imported from). `set <id> key=` (empty value) removes order, branch, pr, title or blocked_on
# (blocked_on only off a blocked task). add also takes
# depends_on=a,b; a task added without project= inherits it from the first dependency that has one
# (so does a later `depend`, when the task still has none).
#
# FLEET_FILE env overrides the path; default is state/fleet.json at repo root.
# Every command that writes fleet.json holds a lock on <fleet>.lock for its whole read-modify-write (flock, or an
# mkdir lock where flock is missing), so parallel calls cannot lose each other's update.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
FLEET="${FLEET_FILE:-$ROOT/state/fleet.json}"
STATE_DIR="$(dirname "$FLEET")"
ARCHIVE="$STATE_DIR/fleet-archive.jsonl"
TASKS="$STATE_DIR/tasks"

STATES='["queued","active","parked","blocked","done","failed"]'
SHAPES='["scout","ship"]'
KINDS='["issue","plan","research","explainer","review"]'
MAXLEN=200
TITLEMAX=160
SLUG_RE='^[a-z0-9][a-z0-9-]*$'
SETTABLE="intent shape state branch pr project title order legacyId blocked_on canvas_kind parent kind"
NODE_KINDS='["group"]'
MAX_ANCESTORS=2
# v1 run-state keys: Paseo's now (label fm.task), the log, the task folder, or computed. Named so the refusal can point at the new home.
RUNSTATE_KEYS="status agentId workspaceId lastEvent notes preview provider"

# jq: give every ask of a task a stable id ("a1", "a2", ...) and keep .askSeq (the highest number ever handed out) ahead
# of all of them, so an id is never reused after its ask is answered. An existing ask without an id (written before ids
# existed) gets "a<its 1-based index>" at its first touch, or the next free number if that one is taken.
ENSURE_IDS='
def ensure_ids:
  (.asks // []) as $a
  | ([$a[] | (.id? // "") | select(type == "string") | capture("^a(?<n>[0-9]+)$")? | .n | tonumber] | max // 0) as $mx
  | reduce range(0; $a | length) as $i ({asks: [], seq: ([(.askSeq // 0), $mx] | max), taken: [$a[] | (.id? // "") | select(. != "")]};
      if ($a[$i].id // "") != "" then .asks += [$a[$i]]
      else ("a" + (($i + 1) | tostring)) as $c
        | if (.taken | index($c)) == null
          then .asks += [$a[$i] + {id: $c}] | .taken += [$c] | .seq = ([.seq, ($i + 1)] | max)
          else (.seq + 1) as $s | ("a" + ($s | tostring)) as $d | .asks += [$a[$i] + {id: $d}] | .taken += [$d] | .seq = $s end
      end) as $r
  | . + {asks: $r.asks, askSeq: $r.seq};
'

die() { echo "fleet: $*" >&2; exit 1; }
need_jq() { command -v jq >/dev/null || die "jq is required"; }
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

entry_exists() { # id -> 0/1
  jq -e --arg id "$1" '.tasks | map(select(.id == $id)) | length > 0' "$FLEET" >/dev/null;
}

atomic_jq() { # jq-args... — run jq filter, validate result, rename over fleet
  local tmp
  tmp="$(mktemp "$FLEET.XXXXXX")"
  if ! jq "$@" "$FLEET" >"$tmp"; then rm -f "$tmp"; die "jq failed, fleet.json untouched"; fi
  if ! jq -e . "$tmp" >/dev/null; then rm -f "$tmp"; die "result is not valid JSON, fleet.json untouched"; fi
  mv "$tmp" "$FLEET"
}

check_entry() { # id — validate enum + length invariants on one entry
  local id="$1"
  jq -e --arg id "$1" --argjson st "$STATES" --argjson sh "$SHAPES" --argjson kd "$KINDS" --argjson max "$MAXLEN" \
    --argjson tmax "$TITLEMAX" --arg re "$SLUG_RE" '
    (.tasks | map(select(.id == $id))[0]) as $t
    | (((($t.state) as $s | $st | index($s)) != null)
      and ((($t.project // "") | length == 0) or (($t.project | type) == "string" and ($t.project | test($re))))
      and ((($t.title // "") | length) <= $tmax)
      and ((($t.shape // "scout") as $h | $sh | index($h)) != null)
      and ((($t.canvas_kind // "issue") as $k | $kd | index($k)) != null)
      and ((($t.blocked_on // "") | length) <= $max)
      and (($t.state != "blocked") or (($t.blocked_on // "") | length > 0))
      and (([$t.asks[]? .text | length] | all(. <= $max))))
  ' "$FLEET" >/dev/null || die "entry $id violates schema (state/shape enum, project slug, title or 200-char cap)";
}

# validate a fresh k=v object (from add/set) BEFORE touching the file
check_obj() { # obj-json
  jq -e --argjson nk "$NODE_KINDS" --argjson st "$STATES" --argjson sh "$SHAPES" --argjson kd "$KINDS" --argjson max "$MAXLEN" \
    --argjson tmax "$TITLEMAX" --arg re "$SLUG_RE" -n --argjson o "$1" '
    (((($o.state // null) as $s | if $s == null then true else ($st | index($s)) != null end))
      and ((($o.project // "") | length == 0) or ($o.project | test($re)))
      and ((($o.title // "") | length) <= $tmax)
      and ((($o.shape // null) as $h | if $h == null then true else ($sh | index($h)) != null end))
      and ((($o.canvas_kind // null) as $k | if $k == null then true else ($kd | index($k)) != null end))
      and ((($o.order // 0) | type) == "number" and (($o.order // 0) >= 0) and ((($o.order // 0) | floor) == ($o.order // 0)))
      and ((($o.legacyId // "") | length == 0) or (($o.legacyId | type) == "string" and ($o.legacyId | test($re))))
      and ((($o.kind // null) as $k | if $k == null then true else ($nk | index($k)) != null end))
      and ((($o.parent // "") | length == 0) or (($o.parent | type) == "string" and ($o.parent | test($re))))
      and ((($o.blocked_on // "") | length) <= $max))
  ' >/dev/null || die "refused: bad state/shape/canvas_kind enum, project slug, title over $TITLEMAX chars, blocked_on over $MAXLEN chars, order that is not a whole number, or legacyId that is not a kebab slug, kind other than group, or parent that is not a kebab slug";
}

# blocked <=> blocked_on: a blocked task must say what it waits on, and blocked_on on any other state is refused
check_blocked() { # obj state blocked_on
  if [[ "$2" == "blocked" ]]; then
    [[ -n "$3" ]] || die "refused: state=blocked needs blocked_on=\"<what or who it waits on>\""
    # "blocked on the captain" is the captain's move, not a block: it would hide the question from Needs you
    if grep -Eqi '(^|[^a-z])(the )?(captain|human|user|mrigank)([^a-z]|$)' <<<"$3"; then
      die "refused: blocked_on=\"$3\" means a wait on the captain. Do not park it as blocked: file an ask (bin/fleet ask) so the card lands in Needs you. blocked is only for outside parties or other tasks."
    fi
  elif [[ -n "$3" ]]; then
    die "refused: blocked_on only goes with state=blocked (state is '$2')"
  fi
}

# --- task tree -------------------------------------------------------------------------------------------------
# Why <parent> cannot be the parent of <id> (mirrors server/tree.ts parentError); prints nothing when it can.
parent_error() { # id parent [kind]
  jq -r --arg id "$1" --arg p "$2" --arg kind "${3:-}" --argjson max "$MAX_ANCESTORS" '
    (.tasks | map({(.id): .}) | add // {}) as $by
    | def up($x): limit(10; ($by[$x].parent? // empty) as $q | ($q, up($q)));
      def kids($x): [$by[] | select(.parent == $x) | .id];
      def desc($x): kids($x)[] as $c | ($c, desc($c));
      if $p == $id then "a task cannot be the parent of itself"
      elif $by[$p] == null then "no live task \($p) to be the parent"
      elif ($by[$p].kind // "") != "group" then "\($p) is not a group (kind=group): only a group can have children"
      else ([up($p)]) as $upp
        | if ($upp | index($id)) != null then "that would be a cycle: \($id) is already above \($p)"
          else ([desc($id) | ([up(.)] | index($id) + 1)] | max // 0) as $below
            | (if ($kind == "group" or ($by[$id].kind // "") == "group") then ([$below, 1] | max) else $below end) as $below
            | if ($upp | length) + 1 + $below > $max then "\($id) would sit deeper than \($max) levels under the project" else empty end
          end
      end' "$FLEET"
}
node_field() { # id field -> value or empty (live tasks)
  jq -r --arg id "$1" --arg f "$2" '.tasks | map(select(.id == $id))[0][$f] // empty' "$FLEET"
}
# ids of every live descendant of <id>, one per line
descendants_of() {
  jq -r --arg id "$1" '(.tasks | map({(.id): .}) | add // {}) as $by
    | def kids($x): [$by[] | select(.parent == $x) | .id];
      def desc($x): kids($x)[] as $c | ($c, desc($c));
      desc($id)' "$FLEET"
}
# open (not done/failed) leaf or group descendants of <id>; count on stdout
open_descendants() {
  jq -r --arg id "$1" '(.tasks | map({(.id): .}) | add // {}) as $by
    | def kids($x): [$by[] | select(.parent == $x) | .id];
      def desc($x): kids($x)[] as $c | ($c, desc($c));
    [desc($id) | $by[.] | select(.state != "done" and .state != "failed" and (.kind // "") != "group")] | length' "$FLEET"
}
# node claims: tasks/<id>/claim.json holds the second mate's agent id
claim_of() { jq -r '.agentId // empty' "$TASKS/$1/claim.json" 2>/dev/null || true; }
# the node a second mate (agent id in PASEO_AGENT_ID) holds, if any
actor_node() {
  local a="${PASEO_AGENT_ID:-}" f
  [[ -n "$a" && -d "$TASKS" ]] || return 0
  for f in "$TASKS"/*/claim.json; do
    [[ -e "$f" ]] || continue
    if [[ "$(jq -r '.agentId // empty' "$f" 2>/dev/null)" == "$a" ]]; then basename "$(dirname "$f")"; return; fi
  done
}
# A second mate writes only inside its node's subtree. $2 = "node-ok" also allows the node itself (log, card, ask).
scope_guard() { # id [node-ok]
  local node; node="$(actor_node)"
  [[ -n "$node" ]] || return 0
  local id="$1"
  if [[ "$id" == "$node" && "${2:-}" == "node-ok" ]]; then return 0; fi
  if descendants_of "$node" | grep -qxF "$id"; then return 0; fi
  die "refused: this agent is the second mate of '$node' and may only write inside its subtree${2:+ (or log/card/ask on the group itself)}; '$id' is outside it. Ask the first mate."
}

cmd_get() { jq -c --arg id "$1" '.tasks | map(select(.id == $id))[0] // empty' "$FLEET"; }
# stage-cli.ts helper (node): FLEET_STAGE_TOOL replaces the node call (a stub in tests); it needs the fleet at <root>/state/fleet.json
stage_tool() { # args after the script: <cmd> <root-placeholder replaced here> ...
  local cmd="$1"; shift
  if [[ -n "${FLEET_STAGE_TOOL:-}" ]]; then "$FLEET_STAGE_TOOL" "$cmd" "$(dirname "$STATE_DIR")" "$@"; return; fi
  command -v node >/dev/null || die "node is required for $cmd"
  [[ "$(basename "$STATE_DIR")" == "state" ]] || die "$cmd needs the fleet at <root>/state/fleet.json (FLEET_FILE is $FLEET)"
  NODE_NO_WARNINGS=1 node "$ROOT/plugin/firstmate-deck/server/stage-cli.ts" "$cmd" "$(dirname "$STATE_DIR")" "$@"
}
# an agent -> its task: the agent's fm.task label (Paseo's), then the archive's agents/agentId lists
cmd_by_agent() {
  local a="$1" t=""
  t="$(stage_tool task-of "$a" 2>/dev/null || true)"
  if [[ -n "$t" ]]; then
    local live; live="$(cmd_get "$t")"
    if [[ -n "$live" ]]; then printf '%s\n' "$live"; return; fi
    if [[ -f "$ARCHIVE" ]]; then
      local line; line="$(jq -R -c --arg id "$t" 'fromjson? | select(.id == $id)' "$ARCHIVE" | tail -n 1)"
      if [[ -n "$line" ]]; then printf '%s\n' "$line"; return; fi
    fi
  fi
  [[ -f "$ARCHIVE" ]] || return 0
  jq -R -c --arg a "$a" 'fromjson? | select(.agentId? == $a or ((.agents? // []) | index($a) != null))' "$ARCHIVE" | tail -n 1
}
# stage / stages: read-only, computed by plugin/firstmate-deck/server/stage-cli.ts (needs node and the paseo CLI)
cmd_stage() { stage_tool "$@"; }
cmd_active() {
  local proj=""
  if [[ $# -gt 0 ]]; then
    [[ "$1" == "--project" && $# -eq 2 ]] || die "usage: fleet active [--project <p>]"
    proj="$2"
  fi
  jq -c --arg p "$proj" '[.tasks[] | select(.state == "active")
    | select($p == "" or .project == $p)
    | {id, state, since, project}]' "$FLEET";
}
cmd_project() {
  local p="$1"; shift
  [[ "$p" =~ $SLUG_RE ]] || die "bad project slug '$p'"
  if [[ $# -eq 0 ]]; then
    jq -c --arg p "$p" '.tasks[] | select(.project == $p)' "$FLEET"; return
  fi
  [[ "$1" == "--archive" ]] || die "usage: fleet project <p> [--archive [N]]"
  local n="${2:-30}"
  [[ "$n" =~ ^[0-9]+$ ]] || die "archive count must be a number, got '$n'"
  [[ -f "$ARCHIVE" ]] || return 0
  jq -c --arg p "$p" 'select(.project == $p)' "$ARCHIVE" | tail -n "$n";
}
cmd_asks() {
  jq -r '.tasks[] | select((.asks // []) | length > 0)
    | .id as $id | .asks | to_entries[] | "\($id) [\(.value.id // ("a" + (.key + 1 | tostring)))]: \(.value.text) (since \(.value.since))"' "$FLEET";
}

# parse k=v pairs into a jq object; refuse unknown keys and overlong notes
build_obj() { # out: OBJ json with $keys validated; sets global OBJ
  local allow="$1"; shift
  local obj="{}"
  for kv in "$@"; do
    [[ "$kv" == *=* ]] || die "expected key=value, got '$kv'"
    local k="${kv%%=*}" v="${kv#*=}"
    if [[ " $RUNSTATE_KEYS " == *" $k "* ]]; then
      case "$k" in
        status) die "'status' is gone; use state=queued|active|parked|blocked|done|failed. running / needs-captain are computed (bin/fleet stage); a question for the captain is an ask";;
        notes) die "'notes' is gone; narrative goes to the task log (bin/fleet log), the summary to its card (bin/fleet card); see docs/STATE.md";;
        preview) die "'preview' is not a registry field; use bin/fleet preview <id> <port> <pid> (tasks/<id>/preview.json)";;
        *) die "'$k' is Paseo's, not the registry's (label fm.task / the agent's own record); see docs/STATE.md";;
      esac
    fi
    [[ " $allow " == *" $k "* ]] || die "unknown key '$k' (allowed: $allow)"
    obj="$(jq --arg k "$k" --arg v "$v" '. + {($k): $v}' <<<"$obj")"
  done
  # empty project means "none"
  # order is a whole number when it looks like one (a bad value stays a string, which check_obj refuses)
  jq -c 'if (.project? // null) == "" then .project = null else . end
    | if ((.order? // null) | type) == "string" and (.order | test("^[0-9]+$")) then .order |= tonumber else . end' <<<"$obj";
}

# the project of the first of the given task ids that has one, looking in the live tasks and then the archive
project_of_deps() { # dep-id...
  local d p
  for d in "$@"; do
    p="$(jq -r --arg d "$d" '.tasks | map(select(.id == $d))[0].project // empty' "$FLEET")"
    if [[ -z "$p" && -f "$ARCHIVE" ]]; then
      p="$(jq -R -r --arg d "$d" 'fromjson? | select(.id == $d) | .project // empty' "$ARCHIVE" | tail -n 1)"
    fi
    [[ -z "$p" ]] || { printf '%s' "$p"; return; }
  done
}

# parent handling for add: validate, inherit the parent's project, and keep a second mate inside its subtree.
tree_check_new() { # id objvar
  local id="$1" ov="$2" par err pp
  par="$(jq -r '.parent // empty' <<<"${!ov}")"
  if [[ -n "$par" ]]; then
    err="$(parent_error "$id" "$par" "$(jq -r '.kind // empty' <<<"${!ov}")")"; [[ -z "$err" ]] || die "refused: $err"
    pp="$(node_field "$par" project)"
    local cp; cp="$(jq -r '.project // empty' <<<"${!ov}")"
    if [[ -n "$cp" && -n "$pp" && "$cp" != "$pp" ]]; then die "refused: $id is in project $cp but its parent $par is in $pp"; fi
    if [[ -z "$cp" && -n "$pp" ]]; then printf -v "$ov" '%s' "$(jq -c --arg p "$pp" '.project = $p' <<<"${!ov}")"; fi
    scope_guard "$par" node-ok
  else
    local node; node="$(actor_node)"
    [[ -z "$node" ]] || die "refused: this agent is the second mate of '$node': a new task needs parent=$node (or a group below it)"
  fi
}

cmd_add() {
  local id="$1"; shift
  [[ "$id" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "id must be a kebab slug, got '$id'"
  entry_exists "$id" && die "task $id already exists"
  local obj; obj="$(build_obj "$SETTABLE depends_on" "$@")"
  for req in intent shape state; do
    jq -e --arg k "$req" '.[$k] // empty | length > 0' <<<"$obj" >/dev/null \
      || die "add needs $req=... (got: $*)";
  done
  obj="$(jq -c 'if .parent == "" then del(.parent) else . end | if .kind == "" then del(.kind) else . end' <<<"$obj")"
  tree_check_new "$id" obj
  # depends_on=a,b -> an array of slugs; project is inherited from the first dependency that has one
  local deps=() d
  if jq -e 'has("depends_on")' <<<"$obj" >/dev/null; then
    IFS=',' read -r -a deps <<<"$(jq -r '.depends_on' <<<"$obj")"
    for d in "${deps[@]}"; do
      [[ "$d" =~ $SLUG_RE ]] || die "bad dep id '$d' in depends_on"
      [[ "$d" != "$id" ]] || die "task $id cannot depend on itself"
    done
    obj="$(jq -c --argjson d "$(printf '%s\n' "${deps[@]}" | jq -R . | jq -sc 'unique_by(.) | .')" '.depends_on = $d' <<<"$obj")"
  fi
  if ((${#deps[@]})) && ! jq -e '(.project // "") != ""' <<<"$obj" >/dev/null; then
    local inh; inh="$(project_of_deps "${deps[@]}")"
    if [[ -n "$inh" ]]; then
      obj="$(jq -c --arg p "$inh" '.project = $p' <<<"$obj")"
      echo "fleet: $id inherits project=$inh from its dependencies" >&2
    fi
  fi
  check_obj "$obj"
  check_blocked "$obj" "$(jq -r '.state' <<<"$obj")" "$(jq -r '.blocked_on // ""' <<<"$obj")"
  local ts; ts="$(now)"
  atomic_jq --arg id "$id" --argjson o "$obj" --arg ts "$ts" \
    '.version = 2 | .tasks += [($o + {id: $id, asks: [], since: $ts})]';
}

# tree rules for set: a second mate stays in its subtree and never edits its own group's state/parent/kind; a new parent must be a
# valid group of the same project; a group with children keeps kind and project.
tree_check_set() { # id obj unset-keys
  local id="$1" obj="$2" un=" $3 " node par err
  node="$(actor_node)"
  if [[ -n "$node" ]]; then
    if [[ "$id" == "$node" ]]; then
      die "refused: this agent is the second mate of '$node' and cannot change its own group (state, parent, kind). Status goes up through scripts: bin/fleet rollup, the finish gate"
    fi
    scope_guard "$id"
    if jq -e 'has("parent")' <<<"$obj" >/dev/null || [[ "$un" == *" parent "* ]]; then
      par="$(jq -r '.parent // empty' <<<"$obj")"
      [[ -n "$par" ]] || die "refused: a second mate cannot move a task out of its group"
      scope_guard "$par" node-ok
    fi
  fi
  if jq -e 'has("parent")' <<<"$obj" >/dev/null; then
    par="$(jq -r '.parent' <<<"$obj")"
    err="$(parent_error "$id" "$par" "$(jq -r '.kind // empty' <<<"$obj")")"; [[ -z "$err" ]] || die "refused: $err"
    local pp cp; pp="$(node_field "$par" project)"
    cp="$(jq -r --arg d "$(node_field "$id" project)" 'if has("project") then (.project // "") else $d end' <<<"$obj")"
    if [[ -n "$cp" && -n "$pp" && "$cp" != "$pp" ]]; then die "refused: $id is in project $cp but its parent $par is in $pp"; fi
  fi
  if [[ "$(node_field "$id" kind)" == "group" ]] && [[ -n "$(descendants_of "$id")" ]]; then
    if [[ "$un" == *" kind "* ]] || { jq -e 'has("kind")' <<<"$obj" >/dev/null && [[ "$(jq -r .kind <<<"$obj")" != "group" ]]; }; then
      die "refused: $id is a group with children; move or archive them before it stops being a group"
    fi
    if jq -e 'has("project")' <<<"$obj" >/dev/null && [[ "$(jq -r '.project // empty' <<<"$obj")" != "$(node_field "$id" project)" ]]; then
      die "refused: $id is a group with children; changing its project would split the tree"
    fi
  fi
}

cmd_set() {
  local id="$1"; shift
  entry_exists "$id" || die "no task $id";
  [[ $# -gt 0 ]] || die "set needs at least one key=value"
  # `key=` (empty) on an optional field removes it; everything else goes through build_obj
  local kv rest=() unset_keys=()
  for kv in "$@"; do
    case "$kv" in
      order=|branch=|pr=|title=|blocked_on=|parent=|kind=) unset_keys+=("${kv%=}");;
      *) rest+=("$kv");;
    esac
  done
  local obj; obj="$(build_obj "$SETTABLE" ${rest[@]+"${rest[@]}"})"
  check_obj "$obj"  # validate BEFORE touching the file: a refusal changes nothing
  tree_check_set "$id" "$obj" "${unset_keys[*]-}"
  # blocked_on follows the state: required while blocked, dropped when the state moves off blocked
  local cur_st cur_bo new_st new_bo
  cur_st="$(jq -r --arg id "$id" '.tasks | map(select(.id == $id))[0].state' "$FLEET")"
  cur_bo="$(jq -r --arg id "$id" '.tasks | map(select(.id == $id))[0].blocked_on // ""' "$FLEET")"
  new_st="$(jq -r --arg d "$cur_st" '.state // $d' <<<"$obj")"
  if [[ " ${unset_keys[*]} " == *" blocked_on "* ]]; then new_bo=""
  elif jq -e 'has("blocked_on")' <<<"$obj" >/dev/null; then new_bo="$(jq -r '.blocked_on' <<<"$obj")"
  elif [[ "$new_st" == "blocked" ]]; then new_bo="$cur_bo"
  else new_bo=""; fi
  check_blocked "$obj" "$new_st" "$new_bo"
  # asks change only through ask/answer, never set.
  # `since` is when `state` last changed: stamped only on a real change
  local stamp="null"
  if [[ "$new_st" != "$cur_st" ]]; then stamp="\"$(now)\""; fi
  local unset_json; unset_json="$(printf '%s\n' "${unset_keys[@]}" | jq -R . | jq -sc 'map(select(length > 0))')"
  atomic_jq --arg id "$id" --argjson o "$obj" --argjson stamp "$stamp" --argjson un "$unset_json" \
    '.tasks |= map(if .id == $id then (. + $o + (if $stamp == null then {} else {since: $stamp} end)) | del(.[$un[]]) | if .state != "blocked" then del(.blocked_on) else . end else . end)';
  check_entry "$id";
}

# Write ids onto the asks of a task that has some without (a no-op when all have one).
ensure_ask_ids() { # task-id
  jq -e --arg id "$1" '.tasks | map(select(.id == $id))[0] | (.asks // []) | all(.[]; (.id // "") != "")' "$FLEET" >/dev/null && return 0
  atomic_jq --arg id "$1" "$ENSURE_IDS"' .tasks |= map(if .id == $id then ensure_ids else . end)'
}

# <ask> argument (a stable id like a2, or a plain 1-based number) -> the ask's id on stdout. Writes ids first.
resolve_ask() { # task-id ref
  local id="$1" ref="$2" aid
  ensure_ask_ids "$id"
  if [[ "$ref" =~ ^a[0-9]+$ ]]; then
    jq -e --arg id "$id" --arg a "$ref" '.tasks | map(select(.id == $id))[0] | (.asks // []) | any(.[]; .id == $a)' "$FLEET" >/dev/null \
      || die "task $id has no open ask $ref (see 'fleet asks')"
    printf '%s' "$ref"; return
  fi
  [[ "$ref" =~ ^[0-9]+$ ]] && ((ref >= 1)) || die "expected an ask id like a2 or a 1-based index, got '$ref' (see 'fleet asks')"
  aid="$(jq -r --arg id "$id" --argjson n "$ref" '.tasks | map(select(.id == $id))[0] | (.asks // []) | .[$n - 1].id // empty' "$FLEET")"
  [[ -n "$aid" ]] || die "task $id has only $(jq --arg id "$id" '.tasks | map(select(.id == $id))[0] | (.asks // []) | length' "$FLEET") open ask(s)"
  printf '%s' "$aid"
}

# the number the next ask of a task takes (ids are never reused)
next_ask_n() { # task-id
  jq -r --arg id "$1" "$ENSURE_IDS"' .tasks | map(select(.id == $id))[0] | ensure_ids | .askSeq + 1' "$FLEET"
}

# options "A|B|C" -> JSON array on stdout; refuses <2 or >6 options, empty or >60-char ones
parse_options() {
  local raw="$1" arr
  arr="$(jq -Rc 'split("|") | map(gsub("^\\s+|\\s+$"; ""))' <<<"$raw")"
  jq -e 'length >= 2 and length <= 6 and all(.[]; length > 0 and length <= 60)' <<<"$arr" >/dev/null \
    || die "--options needs 2-6 non-empty choices of at most 60 chars each, separated by |"
  printf '%s' "$arr"
}

# The headings a task-ask context file carries, in order: the same structure the crew canvas has when it asks the captain.
CTX_HEADINGS=("BLUF" "Issue" "Impact" "Context and components" "Changes by component" "Fix plan" "Ask")

cmd_ask_template() {
  local k=""
  [[ $# -eq 0 ]] || k="$(task_kind "$1")"
  if [[ -n "$k" && "$k" != issue ]]; then
    cat <<'TPL'
Free form (canvas.kind is not issue): no required headings. Say what the captain
needs to decide and why, with whatever figures, tables or sections help.
TPL
    return
  fi
  cat <<'TPL'
## BLUF
The outcome in one or two plain sentences, then the one decision needed.

## Issue
What is wrong or undecided, in 2-4 plain lines.

## Impact
Who or what is affected, and what it costs if nothing is done.

## Context and components
The parts involved and how they relate, a short list. Name components, not files.

## Changes by component
One line per component: what changes in behaviour. No code.

## Fix plan
3-6 numbered steps in order, each with its cost or risk when it has one.

## Ask
The decision, and the options with the recommended one first.
TPL
}

# a task's canvas kind (issue|plan|research|explainer|review); absent = issue, so entries made before the label stay strict
task_kind() { # id
  jq -r --arg id "$1" '(.tasks | map(select(.id == $id))[0].canvas_kind) // "issue"' "$FLEET"
}

# A task whose crew has a canvas (live or snapshotted) keeps its one long explanation there; the first mate's context file is then
# only a short note. Taking the snapshot here means a Needs-you card still shows the canvas after the crew is archived.
NOTE_MAX=1200
# FLEET_PAGE_BIN replaces bin/page (the tests use it); FLEET_NO_SNAPSHOT switches snapshots off.
snapshots_on() { [[ -z "${FLEET_NO_SNAPSHOT:-}" && ( "$(basename "$STATE_DIR")" == state || -n "${FLEET_PAGE_BIN:-}" ) && -x "${FLEET_PAGE_BIN:-$ROOT/bin/page}" ]]; }
canvas_snapshot() { # id; returns the snapshot command's status
  FIRSTMATE_ROOT="$(dirname "$STATE_DIR")" timeout 5 "${FLEET_PAGE_BIN:-$ROOT/bin/page}" canvas-snapshot "$1" >/dev/null 2>&1
}
canvas_snapshot_best_effort() { # id
  snapshots_on || return 0
  canvas_snapshot "$1" || true
}
has_canvas() { [[ -s "$TASKS/$1/canvas.final.html" ]]; }

# context file of a task with a canvas: a note of at most NOTE_MAX characters, no required headings. Sets IS_NOTE (not a subshell: die must exit).
IS_NOTE=false
prepare_context() { # id file
  IS_NOTE=false
  canvas_snapshot_best_effort "$1"
  if has_canvas "$1"; then
    local n; n="$(wc -m <"$2" | tr -d ' ')"
    ((n <= NOTE_MAX)) || die "this task has a crew canvas, so the context file is a short note (at most $NOTE_MAX characters, $n given); the canvas is the explanation. Fix the canvas via its crew, or dispatch a new crew for a longer answer"
    IS_NOTE=true
  else
    check_context "$2" "$1"
  fi
}

# refuse a context file without CTX_HEADINGS, each as a markdown heading, in order (case, trailing colon and **bold** ignored)
check_context() {
  local f="$1" got want i=0 missing=() misplaced=() h
  # only an issue task has a required ask structure; every other kind is free form
  [[ -z "${2:-}" || "$(task_kind "$2")" == issue ]] || return 0
  got="$(sed -nE 's/^#{1,6}[[:space:]]+(.*[^[:space:]])[[:space:]]*$/\1/p' "$f" | sed -E 's/[*_`]//g; s/:$//' | tr 'A-Z' 'a-z')"
  # walk the file's headings once, taking the required ones in order; a required heading found only earlier is out of order
  for h in "${CTX_HEADINGS[@]}"; do
    want="$(tr 'A-Z' 'a-z' <<<"$h")"
    if grep -qxF "$want" <<<"$got"; then
      local line; line="$(grep -nxF "$want" <<<"$got" | head -1 | cut -d: -f1)"
      if ((line <= i)); then misplaced+=("$h"); else i="$line"; fi
    else
      missing+=("$h")
    fi
  done
  ((${#missing[@]} + ${#misplaced[@]} == 0)) && return 0
  {
    echo "fleet: context file '$f' lacks the ask structure (markdown headings, in this order: $(printf '%s → ' "${CTX_HEADINGS[@]}" | sed 's/ → $//'))"
    ((${#missing[@]} == 0)) || echo "  missing:      $(IFS=,; echo "${missing[*]}" | sed 's/,/, /g')"
    ((${#misplaced[@]} == 0)) || echo "  out of order: $(IFS=,; echo "${misplaced[*]}" | sed 's/,/, /g')"
    echo "  'bin/fleet ask-template' prints the skeleton"
  } >&2
  exit 1
}

cmd_ask() {
  scope_guard "${1:-}" node-ok
  local id="$1" text="$2" ctx="${3:-}" optraw="${4:-}" refraw="${5:-}"
  entry_exists "$id" || die "no task $id"
  ((${#text} > 0)) || die "ask text is empty"
  ((${#text} <= MAXLEN)) || die "ask over $MAXLEN chars"
  local opts="null" ref="null"
  [[ -z "$optraw" ]] || opts="$(parse_options "$optraw")"
  if [[ -n "$refraw" ]]; then
    ref="$(jq -c . <<<"$refraw" 2>/dev/null)" || die "--ref is not valid JSON"
    jq -e '.kind == "canvas" and (.agentId | type == "string" and length > 0) and (.block | type == "string" and length > 0) and (keys - ["kind","agentId","block"] | length == 0)' <<<"$ref" >/dev/null \
      || die "--ref must be {\"kind\":\"canvas\",\"agentId\":\"..\",\"block\":\"..\"}"
  fi
  local n; n="$(next_ask_n "$id")"
  # an earlier answer can free a number while its context file lingers; never clobber it
  while [[ -e "$TASKS/$id/asks/$n.md" ]]; do n=$((n + 1)); done
  local rel="" note=false
  if [[ -n "$ctx" ]]; then
    [[ -f "$ctx" ]] || die "context file '$ctx' not found"
    prepare_context "$id" "$ctx"; note=$IS_NOTE
    rel="tasks/$id/asks/$n.md"
    mkdir -p "$TASKS/$id/asks"
    cp "$ctx" "$STATE_DIR/$rel"
  fi
  if ! ( atomic_jq --arg id "$id" --arg t "$text" --arg s "$(now)" --arg c "$rel" --argjson n "$n" --argjson o "$opts" --argjson r "$ref" --argjson nt "$note" "$ENSURE_IDS"'
    .tasks |= map(if .id == $id then ensure_ids | .askSeq = $n
      | .asks += [{id: ("a" + ($n | tostring)), text: $t, since: $s}
          + (if $c == "" then {} else {context: $c} + (if $nt then {note: true} else {} end) end) + (if $o == null then {} else {options: $o} end) + (if $r == null then {} else {ref: $r} end)]
      else . end)' ); then
    [[ -z "$rel" ]] || rm -f "$STATE_DIR/$rel"; exit 1
  fi
  echo "a$n"
}

cmd_reask() {
  scope_guard "${1:-}" node-ok
  local id="$1" ref="$2" settext="$3" text="$4" ctx="$5" optraw="${6:-}"
  local opts="null"
  [[ -z "$optraw" ]] || opts="$(parse_options "$optraw")"
  entry_exists "$id" || die "no task $id"
  local aid; aid="$(resolve_ask "$id" "$ref")"
  if ((settext)); then
    ((${#text} > 0)) || die "ask text is empty"
    ((${#text} <= MAXLEN)) || die "ask over $MAXLEN chars"
  fi
  local rel="" k note=false
  if [[ -n "$ctx" ]]; then
    [[ -f "$ctx" ]] || die "context file '$ctx' not found"
    prepare_context "$id" "$ctx"; note=$IS_NOTE
    k="$(next_ask_n "$id")"
    while [[ -e "$TASKS/$id/asks/$k.md" ]]; do k=$((k + 1)); done
    rel="tasks/$id/asks/$k.md"
    mkdir -p "$TASKS/$id/asks"
    cp "$ctx" "$STATE_DIR/$rel"
  fi
  if ! ( atomic_jq --arg id "$id" --arg aid "$aid" --argjson st "$settext" --arg t "$text" --arg c "$rel" --arg s "$(now)" --argjson o "$opts" --argjson nt "$note" '
    .tasks |= map(if .id == $id then .asks |= map(if .id == $aid then (.since = $s
      | (if $st == 1 then .text = $t else . end)
      | (if $o != null then .options = $o else . end)
      | (if $c != "" then .context = $c | (if $nt then .note = true else del(.note) end) else . end)
      | del(.pendingSince)) else . end) else . end)' ); then
    [[ -z "$rel" ]] || rm -f "$STATE_DIR/$rel"; exit 1
  fi
}

cmd_pending() {
  scope_guard "${1:-}" node-ok
  local id="$1" ref="$2"
  entry_exists "$id" || die "no task $id"
  local aid; aid="$(resolve_ask "$id" "$ref")"
  atomic_jq --arg id "$id" --arg aid "$aid" --arg s "$(now)" \
    '.tasks |= map(if .id == $id then .asks |= map(if .id == $aid then .pendingSince = $s else . end) else . end)'
}

cmd_depend() {
  scope_guard "${1:-}"
  local id="$1"; shift
  entry_exists "$id" || die "no task $id"
  for d in "$@"; do
    [[ "$d" =~ $SLUG_RE ]] || die "bad dep id '$d'"
    [[ "$d" != "$id" ]] || die "task $id cannot depend on itself"
  done
  local deps; deps="$(printf '%s\n' "$@" | jq -R . | jq -sc .)"
  atomic_jq --arg id "$id" --argjson d "$deps" \
    '.tasks |= map(if .id == $id then .depends_on = (reduce ((.depends_on // []) + $d)[] as $x ([]; if any(.[]; . == $x) then . else . + [$x] end)) else . end)'
  # a task with no project picks one up from the first of the new dependencies that has one
  if ! jq -e --arg id "$id" '.tasks | map(select(.id == $id))[0] | (.project // "") != ""' "$FLEET" >/dev/null; then
    local inh; inh="$(project_of_deps "$@")"
    if [[ -n "$inh" ]]; then
      atomic_jq --arg id "$id" --arg p "$inh" '.tasks |= map(if .id == $id then .project = $p else . end)'
      echo "fleet: $id inherits project=$inh from its dependencies" >&2
    fi
  fi
}

cmd_undepend() {
  scope_guard "${1:-}"
  local id="$1" dep="$2"
  entry_exists "$id" || die "no task $id"
  atomic_jq --arg id "$id" --arg d "$dep" \
    '.tasks |= map(if .id == $id then .depends_on = ((.depends_on // []) | map(select(. != $d))) else . end)'
}

cmd_answer() {
  scope_guard "${1:-}" node-ok
  local id="$1" ref="$2"
  entry_exists "$id" || die "no task $id"
  local aid; aid="$(resolve_ask "$id" "$ref")"
  # keep the answered ask (text, context path, options) in the task's own folder so a finished card can still show it;
  # fleet.json stays small because the record lives outside it
  mkdir -p "$TASKS/$id"
  jq -c --arg id "$id" --arg aid "$aid" --arg at "$(now)" \
    '.tasks | map(select(.id == $id))[0].asks // [] | map(select(.id == $aid))[0] | . + {answeredAt: $at}' "$FLEET" >>"$TASKS/$id/asks.jsonl"
  atomic_jq --arg id "$id" --arg aid "$aid" \
    '.tasks |= map(if .id == $id then .asks = ((.asks // []) | map(select(.id != $aid))) else . end)';
}

# the preview server is an operational kill handle, not status: it lives in tasks/<id>/preview.json
cmd_preview() {
  scope_guard "${1:-}"
  local id="$1" port="$2" pid="$3"
  entry_exists "$id" || die "no task $id"
  [[ "$port" =~ ^[0-9]+$ ]] && [[ "$pid" =~ ^[0-9]+$ ]] || die "preview needs numeric port and pid"
  mkdir -p "$TASKS/$id"
  printf '{"port":%s,"pid":%s}\n' "$port" "$pid" >"$TASKS/$id/preview.json.tmp.$$" && mv "$TASKS/$id/preview.json.tmp.$$" "$TASKS/$id/preview.json"
}

cmd_clear_preview() {
  scope_guard "${1:-}"
  local id="$1"
  entry_exists "$id" || die "no task $id"
  rm -f "$TASKS/$id/preview.json"
}

cmd_log() {
  scope_guard "${1:-}" node-ok
  local id="$1" text="$2"
  [[ "$id" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "bad id '$id'"
  mkdir -p "$TASKS/$id"
  printf '%s %s\n' "$(now)" "$text" >>"$TASKS/$id/log.md";
}

cmd_archive() {
  local id="$1"
  entry_exists "$id" || die "no task $id"
  scope_guard "$id"
  [[ -z "$(descendants_of "$id")" ]] || die "archive refuses $id: it still has live children ($(descendants_of "$id" | paste -sd, - | sed 's/,/, /g')); archive them first"
  local st; st="$(jq -r --arg id "$id" '.tasks | map(select(.id == $id))[0].state' "$FLEET")"
  [[ "$st" == "done" || "$st" == "failed" ]] \
    || die "archive refuses $id with state '$st' — only done/failed archive";
  local open; open="$(jq --arg id "$id" '.tasks | map(select(.id == $id))[0] | (.asks // []) | length' "$FLEET")"
  ((open == 0)) || die "archive refuses $id with $open open ask(s) — answer them first ('fleet asks', 'fleet answer')";
  # the archive line keeps the task's agents (history) and its verdict; agents recorded at finish, else looked up now
  local ag; ag="$(jq -c --arg id "$id" '.tasks | map(select(.id == $id))[0].agents // empty' "$FLEET")"
  [[ -n "$ag" ]] || ag="$(agents_of "$id")"
  jq -c --arg id "$id" --argjson ag "$ag" '.tasks | map(select(.id == $id))[0] | del(.agents) | . + {agents: $ag, outcome: .state}' "$FLEET" >>"$ARCHIVE";
  atomic_jq --arg id "$id" '.tasks |= map(select(.id != $id))'
}

# the ids of the Paseo agents that worked on a task (label fm.task), oldest first, as a JSON array; [] (and a warning) when unknown
agents_of() { # task-id
  local out
  if out="$(stage_tool agents "$1" 2>/dev/null)" && jq -e 'type == "array"' <<<"$out" >/dev/null 2>&1; then printf '%s' "$out"
  else echo "fleet: could not read the agents of $1 from Paseo; the record has none" >&2; printf '[]'; fi
}

# card <id> (--file f | -): the task's card.md, atomically; unchanged content is not rewritten
cmd_card() {
  scope_guard "${1:-}" node-ok
  local id="${1:-}" src="" content
  shift || true
  case "${1:-}" in
    --file) [[ $# -eq 2 && -f "$2" ]] || die "usage: fleet card <id> (--file <f>|-)"; content="$(cat "$2")";;
    -) content="$(cat)";;
    *) die "usage: fleet card <id> (--file <f>|-)";;
  esac
  [[ "$id" =~ $SLUG_RE ]] || die "bad id '$id'"
  if ! entry_exists "$id" && ! { [[ -f "$ARCHIVE" ]] && jq -R -e --arg id "$id" 'fromjson? | select(.id == $id)' "$ARCHIVE" >/dev/null; }; then die "no task $id (live or archived)"; fi
  local f="$TASKS/$id/card.md" want
  want="$content"  # $(...) already dropped the trailing newlines
  if [[ -f "$f" && "$(cat "$f")" == "$want" ]]; then return 0; fi
  mkdir -p "$TASKS/$id"
  printf '%s\n' "$want" >"$f.tmp.$$" && mv "$f.tmp.$$" "$f"
}

cmd_archive_update() {
  local id="$1"; shift
  [[ $# -gt 0 ]] || die "archive-update needs at least one key=value"
  local last=""
  [[ -f "$ARCHIVE" ]] && last="$(jq -R -c --arg id "$id" 'fromjson? | select(.id == $id)' "$ARCHIVE" | tail -n 1)"
  [[ -n "$last" ]] || die "no archived task $id"
  local obj; obj="$(build_obj "$SETTABLE depends_on" "$@")"
  check_obj "$obj"
  # depends_on=a,b replaces the dependency list ("" clears it)
  jq -c --argjson o "$obj" '. + ($o | if has("depends_on") then .depends_on |= (split(",") | map(select(length > 0))) else . end)' <<<"$last" >>"$ARCHIVE"
}

CODE_PLACEHOLDER="No local code changes recorded yet."

# finish <id> [--failed] [--card -|--card-file f] [--branch b] [--base main]
cmd_finish() {
  local id="" failed=0 cardsrc="" cardfile="" branch="" base="main" closeall=0 nocanvas=0 answers=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --failed) failed=1; shift;;
      --close-asks) closeall=1; shift;;
      --no-canvas) nocanvas=1; shift;;
      --answer) [[ $# -ge 2 ]] || die "--answer needs an ask id (a1) or index"; answers+=("$2"); shift 2;;
      --card) [[ "${2:-}" == "-" ]] || die "--card takes '-' (read the card from stdin); use --card-file <f> for a file"; cardsrc=stdin; shift 2;;
      --card-file) [[ $# -ge 2 ]] || die "--card-file needs a path"; cardfile="$2"; [[ -f "$cardfile" ]] || die "card file '$cardfile' not found"; shift 2;;
      --branch) [[ $# -ge 2 ]] || die "--branch needs a value"; branch="$2"; shift 2;;
      --base) [[ $# -ge 2 ]] || die "--base needs a value"; base="$2"; shift 2;;
      -*) die "unknown option '$1'";;
      *) [[ -z "$id" ]] || die "usage: fleet finish <id> [--failed] [--card -|--card-file <f>] [--branch <b>] [--base main] [--close-asks|--answer <ask>...] [--no-canvas]"; id="$1"; shift;;
    esac
  done
  [[ -n "$id" ]] || die "usage: fleet finish <id> [--failed] [--card -|--card-file <f>] [--branch <b>] [--base main] [--close-asks|--answer <ask>...] [--no-canvas]"
  entry_exists "$id" || die "no task $id"
  [[ "$id" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "bad id '$id'"
  local actor_n; actor_n="$(actor_node)"
  if [[ -n "$actor_n" && "$id" == "$actor_n" ]]; then die "refused: this agent is the second mate of '$id' and cannot finish its own group; the first mate does, once every child is done"; fi
  scope_guard "$id"
  if [[ "$(node_field "$id" kind)" == "group" ]]; then
    local n_open; n_open="$(open_descendants "$id")"
    ((n_open == 0)) || die "finish refuses group $id: $n_open task(s) under it are still open (a group is done only when every child is)"
    nocanvas=1  # a group has no crew canvas of its own to save: its card is rebuilt from its children (group-card)
  fi
  local card=""
  [[ "$cardsrc" != stdin ]] || card="$(cat)"
  [[ -z "$cardfile" ]] || card="$(cat "$cardfile")"

  # open asks: finish refuses to leave them behind. Check everything BEFORE changing anything
  ensure_ask_ids "$id"
  local open_ids close_ids=() a
  open_ids="$(jq -r --arg id "$id" '.tasks | map(select(.id == $id))[0] | (.asks // [])[] | .id' "$FLEET")"
  if ((closeall)); then
    ((${#answers[@]} == 0)) || die "--close-asks and --answer are exclusive"
    while IFS= read -r a; do [[ -z "$a" ]] || close_ids+=("$a"); done <<<"$open_ids"
  else
    for a in ${answers[@]+"${answers[@]}"}; do close_ids+=("$(resolve_ask "$id" "$a")"); done
  fi
  local left=() o
  while IFS= read -r o; do
    [[ -z "$o" ]] && continue
    [[ " ${close_ids[*]-} " == *" $o "* ]] || left+=("$o")
  done <<<"$open_ids"
  ((${#left[@]} == 0)) || die "finish refuses $id with ${#left[@]} open ask(s) ($(IFS=,; echo "${left[*]}" | sed 's/,/, /g')): answer them in the same command (--close-asks, or --answer ${left[0]}) or 'fleet answer' them first"
  # the canvas is the only deliverable: keep it now, before the crew is archived, and refuse to finish without a saved copy.
  # --failed and --no-canvas skip the refusal (the snapshot is still tried for --failed). --no-canvas is automatic for a task with no crew agent or whose crew was dispatched with canvas=off.
  if snapshots_on && ((! nocanvas)) && [[ "$(stage_tool canvas-off "$id" 2>/dev/null || true)" == off ]]; then nocanvas=1; fi
  if snapshots_on && ((! nocanvas)); then
    if ! canvas_snapshot "$id" && ! has_canvas "$id"; then
      ((failed)) || die "finish refuses $id: its canvas could not be saved (state/tasks/$id/canvas.final.html), and the canvas is the only deliverable. Fix what 'bin/page canvas-snapshot $id' reports (crew canvas on, agent-canvas running), or pass --no-canvas for a task that never had a canvas"
    fi
  fi
  for a in ${close_ids[@]+"${close_ids[@]}"}; do cmd_answer "$id" "$a"; done

  local status=done; ((failed)) && status=failed
  local objargs=(state="$status")
  [[ -z "$branch" ]] || objargs+=(branch="$branch")
  cmd_set "$id" "${objargs[@]}"
  # remember which Paseo agents worked on it: archive writes them into its line
  local ag; ag="$(agents_of "$id")"
  atomic_jq --arg id "$id" --argjson ag "$ag" '.tasks |= map(if .id == $id then .agents = ((.agents // []) + $ag | unique) else . end)'

  local task; task="$(cmd_get "$id")"
  [[ -n "$branch" ]] || branch="$(jq -r '.branch // empty' <<<"$task")"
  local pr project; pr="$(jq -r '.pr // empty' <<<"$task")"; project="$(jq -r '.project // empty' <<<"$task")"

  # card.md: the given card, else (only when there is none yet) the intent plus branch/PR
  local cfile="$TASKS/$id/card.md"
  if [[ -n "$card" ]]; then
    mkdir -p "$TASKS/$id"; printf '%s\n' "$card" >"$cfile.tmp.$$" && mv "$cfile.tmp.$$" "$cfile"
  elif [[ ! -s "$cfile" ]]; then
    local body refs=""; body="$(jq -r '.intent // empty' <<<"$task")"
    [[ -z "$branch" ]] || refs="Branch: \`$branch\`"
    [[ -z "$pr" ]] || refs+="${refs:+ · }PR: $pr"
    mkdir -p "$TASKS/$id"
    {
      printf '%s\n' "$body"
      [[ -z "$refs" ]] || printf '\n%s\n' "$refs"
    } >"$cfile.tmp.$$" && mv "$cfile.tmp.$$" "$cfile"
  fi

  # commits of the task's branch -> the project's "Local code changes" section
  [[ -n "$project" && -n "$branch" ]] || return 0
  local pcfg="$STATE_DIR/projects/$project/project.json" repo=""
  [[ -f "$pcfg" ]] && repo="$(jq -r '.repo // empty' "$pcfg" 2>/dev/null || true)"
  if [[ -z "$repo" ]]; then echo "fleet: $project has no repo in project.json; skipped the code section" >&2; return 0; fi
  local log
  if ! log="$(git -C "$repo" log --oneline "$base..$branch" 2>&1)"; then
    echo "fleet: could not read commits $base..$branch in $repo ($(head -c 200 <<<"$log")); skipped the code section" >&2; return 0
  fi
  [[ -n "$log" ]] || return 0
  local f="$STATE_DIR/projects/$project/sections/code.md" cur="" line hash stamp added=0 out
  mkdir -p "$(dirname "$f")"
  [[ ! -f "$f" ]] || cur="$(grep -vxF -- "$CODE_PLACEHOLDER" "$f" || true)"
  stamp="$(date '+%Y-%m-%d %H:%M')"
  out="$cur"
  while IFS= read -r line; do
    hash="${line%% *}"
    grep -qF -- " $hash " <<<"$cur " && continue  # already recorded
    out+="${out:+$'\n'}- $stamp $line"; added=$((added + 1))
  done < <(sed -n '1!G;h;$p' <<<"$log")  # oldest commit first
  if ((added)); then printf '%s\n' "$out" >"$f.tmp.$$" && mv "$f.tmp.$$" "$f"; fi
}

usage() {
  sed -n '2,/^set -euo/p' "$0" | sed 's/^# \?//';
}

# ask/reask argument parsing: positionals plus --context-file / --options in any order
parse_ask_args() {
  local pos=() ctx="" opts="" ref=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --context-file) [[ $# -ge 2 ]] || die "--context-file needs a path"; ctx="$2"; shift 2;;
      --options) [[ $# -ge 2 ]] || die "--options needs a value"; opts="$2"; shift 2;;
      --ref) [[ $# -ge 2 ]] || die "--ref needs a JSON value"; ref="$2"; shift 2;;
      *) pos+=("$1"); shift;;
    esac
  done
  [[ ${#pos[@]} -eq 2 ]] || die "usage: fleet ask <id> \"<text>\" [--context-file <path>] [--options \"A|B|C\"] [--ref <json>]"
  cmd_ask "${pos[0]}" "${pos[1]}" "$ctx" "$opts" "$ref"
}
parse_reask_args() {
  local pos=() ctx="" opts=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --context-file) [[ $# -ge 2 ]] || die "--context-file needs a path"; ctx="$2"; shift 2;;
      --options) [[ $# -ge 2 ]] || die "--options needs a value"; opts="$2"; shift 2;;
      *) pos+=("$1"); shift;;
    esac
  done
  [[ ${#pos[@]} -eq 2 || ${#pos[@]} -eq 3 ]] || die "usage: fleet reask <id> <ask> [\"<new text>\"] [--context-file <path>] [--options \"A|B|C\"]"
  if [[ ${#pos[@]} -eq 3 ]]; then cmd_reask "${pos[0]}" "${pos[1]}" 1 "${pos[2]}" "$ctx" "$opts"
  else cmd_reask "${pos[0]}" "${pos[1]}" 0 "" "$ctx" "$opts"; fi
}


# --- task tree commands ----------------------------------------------------------------------------------------
cmd_children() {
  entry_exists "$1" || die "no task $1"
  jq -c --arg id "$1" '[.tasks[] | select(.parent == $id) | {id, kind: (.kind // "task"), state, title: (.title // null)}]' "$FLEET"
}
cmd_tree() {
  local p="${1:-}"
  [[ -z "$p" || "$p" =~ $SLUG_RE ]] || die "bad project slug '$p'"
  jq -r --arg p "$p" '
    (.tasks | map(select($p == "" or .project == $p))) as $ts
    | ($ts | map(.id)) as $ids
    | def line($t; $d): ("  " * $d) + $t.id + (if ($t.kind // "") == "group" then " [group]" else "" end) + "  " + $t.state
        + (if ($t.title // "") != "" then "  " + $t.title else "" end);
      def walk($t; $d): line($t; $d), ($ts[] | select(.parent == $t.id) | walk(.; $d + 1));
    $ts[] | . as $n | select(($n.parent // "") == "" or (($ids | index($n.parent)) == null)) | walk(.; 0)' "$FLEET"
}
cmd_claim_node() {
  local id="" agent="" replace=0
  while [[ $# -gt 0 ]]; do
    case "$1" in --replace) replace=1; shift;; -*) die "unknown option '$1'";; *) if [[ -z "$id" ]]; then id="$1"; else agent="$1"; fi; shift;; esac
  done
  [[ -n "$id" && -n "$agent" ]] || die "usage: fleet claim-node <id> <agentId> [--replace]"
  [[ -z "$(actor_node)" ]] || die "refused: a second mate cannot claim a node; only the first mate hands a group to a second mate"
  entry_exists "$id" || die "no task $id"
  [[ "$(node_field "$id" kind)" == "group" ]] || die "refused: $id is not a group (kind=group); only a group can have a second mate"
  [[ "$agent" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "bad agent id '$agent'"
  local cur; cur="$(claim_of "$id")"
  if [[ -n "$cur" && "$cur" != "$agent" && $replace -eq 0 ]]; then die "refused: $id is already claimed by $cur (use --replace to hand it to $agent)"; fi
  local a other
  for other in "$TASKS"/*/claim.json; do
    [[ -e "$other" ]] || continue
    if [[ "$(jq -r '.agentId // empty' "$other")" == "$agent" && "$(basename "$(dirname "$other")")" != "$id" ]]; then
      die "refused: $agent already owns $(basename "$(dirname "$other")"); a second mate owns one group"
    fi
  done
  mkdir -p "$TASKS/$id"
  jq -n --arg a "$agent" --arg t "$(now)" '{agentId: $a, claimedAt: $t}' >"$TASKS/$id/claim.json.tmp.$$" && mv "$TASKS/$id/claim.json.tmp.$$" "$TASKS/$id/claim.json"
}
cmd_release_node() {
  local id="$1"
  entry_exists "$id" || die "no task $id"
  local cur; cur="$(claim_of "$id")"
  [[ -n "$cur" ]] || die "$id has no second mate"
  [[ "${PASEO_AGENT_ID:-}" != "$cur" ]] || die "refused: a second mate cannot retire itself; only the first mate releases it (bin/fleet release-node)"
  [[ -z "$(actor_node)" ]] || die "refused: only the first mate retires a second mate"
  rm -f "$TASKS/$id/claim.json"
}
cmd_rollup() { stage_tool rollup "$@"; }
cmd_group_card() {
  [[ "$(node_field "$1" kind)" == "group" ]] || die "$1 is not a group (kind=group)"
  local md; md="$(stage_tool rollup "$1" --markdown)" || die "could not compute the rollup of $1"
  printf '%s\n' "$md" | cmd_card "$1" -
}

# Serialize writers: hold an exclusive lock for the whole command (released when the process exits). The lock file is
# separate from fleet.json, which is replaced by rename. Without flock(1) (macOS) an mkdir lock does the same job.
lock() {
  mkdir -p "$STATE_DIR"
  if command -v flock >/dev/null; then
    exec 9>"$FLEET.lock"
    flock -w 30 9 || die "could not lock $FLEET.lock within 30 s"
    return 0
  fi
  local d="$FLEET.lockd" i
  for ((i = 0; i < 300; i++)); do
    if mkdir "$d" 2>/dev/null; then trap 'rmdir "'"$d"'" 2>/dev/null || true' EXIT; return 0; fi
    # a lock older than 60 s belongs to a crashed writer
    if [[ -n "$(find "$d" -maxdepth 0 -mmin +1 2>/dev/null)" ]]; then rmdir "$d" 2>/dev/null || true; fi
    sleep 0.1
  done
  die "could not lock $FLEET within 30 s"
}

# A v1 registry (no "version": 2) is read-only here: an old file would take v2 writes half-way. An EMPTY one is just stamped.
require_v2() {
  [[ -f "$FLEET" ]] || return 0
  [[ "$(jq -r '.version // 0' "$FLEET")" == "2" ]] && return 0
  jq -e '(.tasks // []) | length == 0' "$FLEET" >/dev/null \
    || die "$FLEET is a v1 registry (no \"version\": 2): run bin/migrate-fleet-v2 first (reads still work, writes are refused)"
  atomic_jq '.version = 2'
}

need_jq
cmd="${1:-}"; shift || true
case "$cmd" in
  add|set|ask|reask|pending|depend|undepend|answer|preview|clear-preview|archive|archive-update|finish|claim-node|release-node) lock; require_v2;; esac
case "$cmd" in
  get)           [[ $# -eq 1 ]] || die "usage: fleet get <id>"; cmd_get "$1";;
  by-agent)      [[ $# -eq 1 ]] || die "usage: fleet by-agent <agentId>"; cmd_by_agent "$1";;
  stage)         [[ $# -eq 1 ]] || die "usage: fleet stage <id>"; cmd_stage stage "$1";;
  stages)        cmd_stage stages "$@";;
  active)        cmd_active "$@";;
  project)       [[ $# -ge 1 && $# -le 3 ]] || die "usage: fleet project <p> [--archive [N]]"; cmd_project "$@";;
  asks)          cmd_asks;;
  add)           [[ $# -ge 1 ]] || die "usage: fleet add <id> k=v ..."; cmd_add "$@";;
  set)           [[ $# -ge 1 ]] || die "usage: fleet set <id> k=v ..."; cmd_set "$@";;
  ask-template)  [[ $# -le 1 ]] || die "usage: fleet ask-template [<id>]"; cmd_ask_template "$@";;
  ask)           parse_ask_args "$@";;
  reask)         parse_reask_args "$@";;
  pending)       [[ $# -eq 2 ]] || die "usage: fleet pending <id> <ask>"; cmd_pending "$1" "$2";;
  depend)        [[ $# -ge 2 ]] || die "usage: fleet depend <id> <dep-id>..."; cmd_depend "$@";;
  undepend)      [[ $# -eq 2 ]] || die "usage: fleet undepend <id> <dep-id>"; cmd_undepend "$@";;
  answer)        [[ $# -eq 2 ]] || die "usage: fleet answer <id> <ask>"; cmd_answer "$1" "$2";;
  preview)       [[ $# -eq 3 ]] || die "usage: fleet preview <id> <port> <pid>"; cmd_preview "$@";;
  clear-preview) [[ $# -eq 1 ]] || die "usage: fleet clear-preview <id>"; cmd_clear_preview "$1";;
  log)           [[ $# -eq 2 ]] || die "usage: fleet log <id> \"<text>\""; cmd_log "$1" "$2";;
  archive)       [[ $# -eq 1 ]] || die "usage: fleet archive <id>"; cmd_archive "$1";;
  card)          [[ $# -ge 2 ]] || die "usage: fleet card <id> (--file <f>|-)"; cmd_card "$@";;
  archive-update) [[ $# -ge 2 ]] || die "usage: fleet archive-update <id> k=v ..."; cmd_archive_update "$@";;
  finish)        cmd_finish "$@";;
  children)      [[ $# -eq 1 ]] || die "usage: fleet children <id>"; cmd_children "$1";;
  tree)          [[ $# -le 1 ]] || die "usage: fleet tree [<project>]"; cmd_tree "$@";;
  rollup)        [[ $# -ge 1 ]] || die "usage: fleet rollup <id> [--markdown]"; cmd_rollup "$@";;
  group-card)    [[ $# -eq 1 ]] || die "usage: fleet group-card <id>"; cmd_group_card "$1";;
  claim-node)    cmd_claim_node "$@";;
  release-node)  [[ $# -eq 1 ]] || die "usage: fleet release-node <id>"; cmd_release_node "$1";;
  *) usage; [[ -n "$cmd" ]] && exit 1; exit 0;;
esac
