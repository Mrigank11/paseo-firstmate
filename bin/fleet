#!/usr/bin/env bash
# bin/fleet — the ONLY writer of state/fleet.json.
#
# Every fleet write goes through this helper. It validates the status/shape
# enums and the notes/ask length cap, then writes atomically (temp file +
# rename) so a crash or truncated edit can never corrupt the file.
# Reads (get, by-agent, active, asks) are plain jq and never mutate.
#
#   bin/fleet get <id>                print one task entry (compact JSON)
#   bin/fleet by-agent <agentId>      print the entry holding an agentId
#   bin/fleet active [--project <p>]  live entries: id, status, agentId (dispatched/running/needs-captain only)
#   bin/fleet project <p>             every LIVE task of project <p>, any status (compact JSON, one per line)
#   bin/fleet project <p> --archive [N]   last N (default 30) archive lines for project <p>
#   bin/fleet asks                    every open ask across live tasks
#   bin/fleet add <id> k=v ...        create a task (needs intent, shape, status)
#   bin/fleet set <id> k=v ...        update scalar fields
#   bin/fleet ask <id> "<text>" [--context-file <path>] [--options "A|B|C"]
#                                     append {text, since} to asks; the file is copied to
#                                     tasks/<id>/asks/<n>.md and linked as "context". --options
#                                     (2-6 choices, each <=60 chars, "|" separated) stores
#                                     options:[..]; the page shows them as buttons
#   bin/fleet reask <id> <n> ["<new text>"] [--context-file <path>] [--options "A|B|C"]
#                                     reset ask n's "since" to now (back to Needs you on the page after
#                                     the captain's follow-up was answered); optionally replace its text
#                                     (<=200 chars), context file and options, the way ask does
#                                     (options are kept when --options is absent)
#   bin/fleet pending <id> <n>        mark ask n as waiting on the first mate's follow-up (sets pendingSince):
#                                     the page keeps it under "With the first mate" instead of Needs you.
#                                     reask and answer clear it. `bin/page reply ... --followup <id>:<n>` calls this
#   bin/fleet depend <id> <dep-id>... append to depends_on (de-duplicated; deps may be archived ids)
#   bin/fleet undepend <id> <dep-id>  remove one id from depends_on
#   bin/fleet answer <id> <n>         resolve ask by 1-based index
#   bin/fleet preview <id> <port> <pid>   record a crew preview server
#   bin/fleet clear-preview <id>      drop the preview record (after killing it)
#   bin/fleet log <id> "<text>"       append a timestamped line to tasks/<id>/log.md
#   bin/fleet archive <id>            move a done/failed ask-free task to the archive
#
# Statuses: queued, parked, dispatched, running, needs-captain, done, failed.
# Optional fields (add/set): project (kebab slug, empty = none), title (<=80 chars).
#
# FLEET_FILE env overrides the path; default is state/fleet.json at repo root.
# Every command that writes fleet.json holds an flock on <fleet>.lock for its whole read-modify-write, so
# parallel calls (several tool calls at once) cannot lose each other's update.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
FLEET="${FLEET_FILE:-$ROOT/state/fleet.json}"
STATE_DIR="$(dirname "$FLEET")"
ARCHIVE="$STATE_DIR/fleet-archive.jsonl"
TASKS="$STATE_DIR/tasks"

STATUSES='["queued","parked","dispatched","running","needs-captain","done","failed"]'
SHAPES='["scout","ship"]'
MAXLEN=200
TITLEMAX=80
SLUG_RE='^[a-z0-9][a-z0-9-]*$'
SETTABLE="intent shape provider agentId workspaceId status branch pr lastEvent notes project title"

die() { echo "fleet: $*" >&2; exit 1; }
need_jq() { command -v jq >/dev/null || die "jq is required"; }
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

entry_exists() { # id -> 0/1
  jq -e --arg id "$1" '.tasks | map(select(.id == $id)) | length > 0' "$FLEET" >/dev/null;
}

atomic_jq() { # jq-args... — run jq filter, validate result, rename over fleet
  local tmp
  tmp="$(mktemp "$FLEET.XXXXXX")"
  if ! jq "$@" "$FLEET" >"$tmp"; then rm -f "$tmp"; die "jq failed, fleet.json untouched"; fi
  if ! jq -e . "$tmp" >/dev/null; then rm -f "$tmp"; die "result is not valid JSON, fleet.json untouched"; fi
  mv "$tmp" "$FLEET"
}

check_entry() { # id — validate enum + length invariants on one entry
  local id="$1"
  jq -e --arg id "$1" --argjson st "$STATUSES" --argjson sh "$SHAPES" --argjson max "$MAXLEN" \
    --argjson tmax "$TITLEMAX" --arg re "$SLUG_RE" '
    (.tasks | map(select(.id == $id))[0]) as $t
    | (((($t.status) as $s | $st | index($s)) != null)
      and ((($t.project // "") | length == 0) or (($t.project | type) == "string" and ($t.project | test($re))))
      and ((($t.title // "") | length) <= $tmax)
      and ((($t.shape // "scout") as $h | $sh | index($h)) != null)
      and ((($t.notes // "") | length) <= $max)
      and (([$t.asks[]? .text | length] | all(. <= $max))))
  ' "$FLEET" >/dev/null || die "entry $id violates schema (status/shape enum, project slug, title or 200-char cap)";
}

# validate a fresh k=v object (from add/set) BEFORE touching the file
check_obj() { # obj-json
  jq -e --argjson st "$STATUSES" --argjson sh "$SHAPES" --argjson max "$MAXLEN" \
    --argjson tmax "$TITLEMAX" --arg re "$SLUG_RE" -n --argjson o "$1" '
    (((($o.status // null) as $s | if $s == null then true else ($st | index($s)) != null end))
      and ((($o.project // "") | length == 0) or ($o.project | test($re)))
      and ((($o.title // "") | length) <= $tmax)
      and ((($o.shape // null) as $h | if $h == null then true else ($sh | index($h)) != null end))
      and ((($o.notes // "") | length) <= $max))
  ' >/dev/null || die "refused: bad status/shape enum, project slug, title over $TITLEMAX chars, or notes over $MAXLEN chars";
}

cmd_get() { jq -c --arg id "$1" '.tasks | map(select(.id == $id))[0] // empty' "$FLEET"; }
cmd_by_agent() { jq -c --arg a "$1" '.tasks | map(select(.agentId == $a))[0] // empty' "$FLEET"; }
cmd_active() {
  local proj=""
  if [[ $# -gt 0 ]]; then
    [[ "$1" == "--project" && $# -eq 2 ]] || die "usage: fleet active [--project <p>]"
    proj="$2"
  fi
  jq -c --arg p "$proj" '[.tasks[] | select(.status == "dispatched" or .status == "running" or .status == "needs-captain")
    | select($p == "" or .project == $p)
    | {id, status, agentId}]' "$FLEET";
}
cmd_project() {
  local p="$1"; shift
  [[ "$p" =~ $SLUG_RE ]] || die "bad project slug '$p'"
  if [[ $# -eq 0 ]]; then
    jq -c --arg p "$p" '.tasks[] | select(.project == $p)' "$FLEET"; return
  fi
  [[ "$1" == "--archive" ]] || die "usage: fleet project <p> [--archive [N]]"
  local n="${2:-30}"
  [[ "$n" =~ ^[0-9]+$ ]] || die "archive count must be a number, got '$n'"
  [[ -f "$ARCHIVE" ]] || return 0
  jq -c --arg p "$p" 'select(.project == $p)' "$ARCHIVE" | tail -n "$n";
}
cmd_asks() {
  jq -r '.tasks[] | select((.asks // []) | length > 0)
    | .id as $id | .asks | to_entries[] | "\($id) [\(.key + 1)]: \(.value.text) (since \(.value.since))"' "$FLEET";
}

# parse k=v pairs into a jq object; refuse unknown keys and overlong notes
build_obj() { # out: OBJ json with $keys validated; sets global OBJ
  local allow="$1"; shift
  local obj="{}"
  for kv in "$@"; do
    [[ "$kv" == *=* ]] || die "expected key=value, got '$kv'"
    local k="${kv%%=*}" v="${kv#*=}"
    [[ " $allow " == *" $k "* ]] || die "unknown key '$k' (allowed: $allow)"
    obj="$(jq --arg k "$k" --arg v "$v" '. + {($k): $v}' <<<"$obj")"
  done
  # empty project means "none"
  jq -c 'if (.project? // null) == "" then .project = null else . end' <<<"$obj";
}

cmd_add() {
  local id="$1"; shift
  [[ "$id" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "id must be a kebab slug, got '$id'"
  entry_exists "$id" && die "task $id already exists"
  local obj; obj="$(build_obj "$SETTABLE" "$@")"
  for req in intent shape status; do
    jq -e --arg k "$req" '.[$k] // empty | length > 0' <<<"$obj" >/dev/null \
      || die "add needs $req=... (got: $*)";
  done
  check_obj "$obj"
  local ts; ts="$(now)"
  atomic_jq --arg id "$id" --argjson o "$obj" --arg ts "$ts" \
    '.tasks += [($o + {id: $id, asks: [], lastEvent: ($o.lastEvent // $ts)})]';
}

cmd_set() {
  local id="$1"; shift
  entry_exists "$id" || die "no task $id";
  [[ $# -gt 0 ]] || die "set needs at least one key=value"
  local obj; obj="$(build_obj "$SETTABLE" "$@")"
  check_obj "$obj"  # validate BEFORE touching the file: a refusal changes nothing
  # asks/preview change only through ask/answer/preview, never set.
  local stamp="null"
  if jq -e 'has("status")' <<<"$obj" >/dev/null && ! jq -e 'has("lastEvent")' <<<"$obj" >/dev/null; then
    stamp="\"$(now)\"";
  fi
  atomic_jq --arg id "$id" --argjson o "$obj" --argjson stamp "$stamp" \
    '.tasks |= map(if .id == $id then . + $o + (if $stamp == null then {} else {lastEvent: $stamp} end) else . end)';
  check_entry "$id";
}

# options "A|B|C" -> JSON array on stdout; refuses <2 or >6 options, empty or >60-char ones
parse_options() {
  local raw="$1" arr
  arr="$(jq -Rc 'split("|") | map(gsub("^\\s+|\\s+$"; ""))' <<<"$raw")"
  jq -e 'length >= 2 and length <= 6 and all(.[]; length > 0 and length <= 60)' <<<"$arr" >/dev/null \
    || die "--options needs 2-6 non-empty choices of at most 60 chars each, separated by |"
  printf '%s' "$arr"
}

cmd_ask() {
  local id="$1" text="$2" ctx="${3:-}" optraw="${4:-}"
  entry_exists "$id" || die "no task $id"
  ((${#text} > 0)) || die "ask text is empty"
  ((${#text} <= MAXLEN)) || die "ask over $MAXLEN chars"
  local opts="null"
  [[ -z "$optraw" ]] || opts="$(parse_options "$optraw")"
  if [[ -z "$ctx" ]]; then
    atomic_jq --arg id "$id" --arg t "$text" --arg s "$(now)" --argjson o "$opts" \
      '.tasks |= map(if .id == $id then .asks = ((.asks // []) + [{text: $t, since: $s} + (if $o == null then {} else {options: $o} end)]) else . end)'
    return
  fi
  [[ -f "$ctx" ]] || die "context file '$ctx' not found"
  local count n rel
  count="$(jq --arg id "$id" '.tasks | map(select(.id == $id))[0] | (.asks // []) | length' "$FLEET")"
  n=$((count + 1))
  # an earlier answer can free an index while its file lingers; never clobber it
  while [[ -e "$TASKS/$id/asks/$n.md" ]]; do n=$((n + 1)); done
  rel="tasks/$id/asks/$n.md"
  mkdir -p "$TASKS/$id/asks"
  cp "$ctx" "$STATE_DIR/$rel"
  if ! ( atomic_jq --arg id "$id" --arg t "$text" --arg s "$(now)" --arg c "$rel" --argjson o "$opts" \
    '.tasks |= map(if .id == $id then .asks = ((.asks // []) + [{text: $t, since: $s, context: $c} + (if $o == null then {} else {options: $o} end)]) else . end)' ); then
    rm -f "$STATE_DIR/$rel"; exit 1
  fi
}

cmd_reask() {
  local id="$1" n="$2" settext="$3" text="$4" ctx="$5" optraw="${6:-}"
  local opts="null"
  [[ -z "$optraw" ]] || opts="$(parse_options "$optraw")"
  entry_exists "$id" || die "no task $id"
  [[ "$n" =~ ^[0-9]+$ ]] && ((n >= 1)) || die "reask needs a 1-based ask index (see 'fleet asks')"
  local count; count="$(jq --arg id "$id" '.tasks | map(select(.id == $id))[0] | (.asks // []) | length' "$FLEET")"
  ((n <= count)) || die "task $id has only $count open ask(s)"
  if ((settext)); then
    ((${#text} > 0)) || die "ask text is empty"
    ((${#text} <= MAXLEN)) || die "ask over $MAXLEN chars"
  fi
  local rel="" k
  if [[ -n "$ctx" ]]; then
    [[ -f "$ctx" ]] || die "context file '$ctx' not found"
    k=$((count + 1))
    while [[ -e "$TASKS/$id/asks/$k.md" ]]; do k=$((k + 1)); done
    rel="tasks/$id/asks/$k.md"
    mkdir -p "$TASKS/$id/asks"
    cp "$ctx" "$STATE_DIR/$rel"
  fi
  if ! ( atomic_jq --arg id "$id" --argjson n "$n" --argjson st "$settext" --arg t "$text" --arg c "$rel" --arg s "$(now)" --argjson o "$opts" '
    .tasks |= map(if .id == $id then .asks[$n - 1] |= (.since = $s
      | (if $st == 1 then .text = $t else . end)
      | (if $o != null then .options = $o else . end)
      | (if $c != "" then .context = $c else . end)
      | del(.pendingSince)) else . end)' ); then
    [[ -z "$rel" ]] || rm -f "$STATE_DIR/$rel"; exit 1
  fi
}

cmd_pending() {
  local id="$1" n="$2"
  entry_exists "$id" || die "no task $id"
  [[ "$n" =~ ^[0-9]+$ ]] && ((n >= 1)) || die "pending needs a 1-based ask index (see 'fleet asks')"
  local count; count="$(jq --arg id "$id" '.tasks | map(select(.id == $id))[0] | (.asks // []) | length' "$FLEET")"
  ((n <= count)) || die "task $id has only $count open ask(s)"
  atomic_jq --arg id "$id" --argjson n "$n" --arg s "$(now)" \
    '.tasks |= map(if .id == $id then .asks[$n - 1].pendingSince = $s else . end)'
}

cmd_depend() {
  local id="$1"; shift
  entry_exists "$id" || die "no task $id"
  for d in "$@"; do
    [[ "$d" =~ $SLUG_RE ]] || die "bad dep id '$d'"
    [[ "$d" != "$id" ]] || die "task $id cannot depend on itself"
  done
  local deps; deps="$(printf '%s\n' "$@" | jq -R . | jq -sc .)"
  atomic_jq --arg id "$id" --argjson d "$deps" \
    '.tasks |= map(if .id == $id then .depends_on = (reduce ((.depends_on // []) + $d)[] as $x ([]; if any(.[]; . == $x) then . else . + [$x] end)) else . end)'
}

cmd_undepend() {
  local id="$1" dep="$2"
  entry_exists "$id" || die "no task $id"
  atomic_jq --arg id "$id" --arg d "$dep" \
    '.tasks |= map(if .id == $id then .depends_on = ((.depends_on // []) | map(select(. != $d))) else . end)'
}

cmd_answer() {
  local id="$1" n="$2"
  entry_exists "$id" || die "no task $id"
  [[ "$n" =~ ^[0-9]+$ ]] && ((n >= 1)) || die "answer needs a 1-based ask index (see 'fleet asks')"
  local count; count="$(jq --arg id "$id" '.tasks | map(select(.id == $id))[0] | (.asks // []) | length' "$FLEET")"
  ((n <= count)) || die "task $id has only $count open ask(s)"
  atomic_jq --arg id "$id" --argjson n "$n" \
    '.tasks |= map(if .id == $id then .asks = ((.asks // []) | del(.[$n - 1])) else . end)';
}

cmd_preview() {
  local id="$1" port="$2" pid="$3"
  entry_exists "$id" || die "no task $id"
  [[ "$port" =~ ^[0-9]+$ ]] && [[ "$pid" =~ ^[0-9]+$ ]] || die "preview needs numeric port and pid"
  atomic_jq --arg id "$id" --argjson port "$port" --argjson pid "$pid" \
    '.tasks |= map(if .id == $id then .preview = {port: $port, pid: $pid} else . end)';
}

cmd_clear_preview() {
  local id="$1"
  entry_exists "$id" || die "no task $id"
  atomic_jq --arg id "$id" '.tasks |= map(if .id == $id then del(.preview) else . end)';
}

cmd_log() {
  local id="$1" text="$2"
  [[ "$id" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "bad id '$id'"
  mkdir -p "$TASKS/$id"
  printf '%s %s\n' "$(now)" "$text" >>"$TASKS/$id/log.md";
}

cmd_archive() {
  local id="$1"
  entry_exists "$id" || die "no task $id"
  local st; st="$(jq -r --arg id "$id" '.tasks | map(select(.id == $id))[0].status' "$FLEET")"
  [[ "$st" == "done" || "$st" == "failed" ]] \
    || die "archive refuses $id with status '$st' — only done/failed archive";
  local open; open="$(jq --arg id "$id" '.tasks | map(select(.id == $id))[0] | (.asks // []) | length' "$FLEET")"
  ((open == 0)) || die "archive refuses $id with $open open ask(s) — answer them first ('fleet asks', 'fleet answer')";
  jq -c --arg id "$id" '.tasks | map(select(.id == $id))[0]' "$FLEET" >>"$ARCHIVE";
  atomic_jq --arg id "$id" '.tasks |= map(select(.id != $id))';
}

usage() {
  sed -n '2,/^set -euo/p' "$0" | sed 's/^# \?//';
}

# ask/reask argument parsing: positionals plus --context-file / --options in any order
parse_ask_args() {
  local pos=() ctx="" opts=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --context-file) [[ $# -ge 2 ]] || die "--context-file needs a path"; ctx="$2"; shift 2;;
      --options) [[ $# -ge 2 ]] || die "--options needs a value"; opts="$2"; shift 2;;
      *) pos+=("$1"); shift;;
    esac
  done
  [[ ${#pos[@]} -eq 2 ]] || die "usage: fleet ask <id> \"<text>\" [--context-file <path>] [--options \"A|B|C\"]"
  cmd_ask "${pos[0]}" "${pos[1]}" "$ctx" "$opts"
}
parse_reask_args() {
  local pos=() ctx="" opts=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --context-file) [[ $# -ge 2 ]] || die "--context-file needs a path"; ctx="$2"; shift 2;;
      --options) [[ $# -ge 2 ]] || die "--options needs a value"; opts="$2"; shift 2;;
      *) pos+=("$1"); shift;;
    esac
  done
  [[ ${#pos[@]} -eq 2 || ${#pos[@]} -eq 3 ]] || die "usage: fleet reask <id> <n> [\"<new text>\"] [--context-file <path>] [--options \"A|B|C\"]"
  if [[ ${#pos[@]} -eq 3 ]]; then cmd_reask "${pos[0]}" "${pos[1]}" 1 "${pos[2]}" "$ctx" "$opts"
  else cmd_reask "${pos[0]}" "${pos[1]}" 0 "" "$ctx" "$opts"; fi
}

# Serialize writers: hold an exclusive lock for the whole command (released when the process exits). The lock
# file is separate from fleet.json, which is replaced by rename. Without flock(1) the commands still work, unlocked.
lock() {
  command -v flock >/dev/null || return 0
  mkdir -p "$STATE_DIR"
  exec 9>"$FLEET.lock"
  flock -w 30 9 || die "could not lock $FLEET.lock within 30 s"
}

need_jq
cmd="${1:-}"; shift || true
case "$cmd" in
  add|set|ask|reask|pending|depend|undepend|answer|preview|clear-preview|archive) lock;; esac
case "$cmd" in
  get)           [[ $# -eq 1 ]] || die "usage: fleet get <id>"; cmd_get "$1";;
  by-agent)      [[ $# -eq 1 ]] || die "usage: fleet by-agent <agentId>"; cmd_by_agent "$1";;
  active)        cmd_active "$@";;
  project)       [[ $# -ge 1 && $# -le 3 ]] || die "usage: fleet project <p> [--archive [N]]"; cmd_project "$@";;
  asks)          cmd_asks;;
  add)           [[ $# -ge 1 ]] || die "usage: fleet add <id> k=v ..."; cmd_add "$@";;
  set)           [[ $# -ge 1 ]] || die "usage: fleet set <id> k=v ..."; cmd_set "$@";;
  ask)           parse_ask_args "$@";;
  reask)         parse_reask_args "$@";;
  pending)       [[ $# -eq 2 ]] || die "usage: fleet pending <id> <n>"; cmd_pending "$1" "$2";;
  depend)        [[ $# -ge 2 ]] || die "usage: fleet depend <id> <dep-id>..."; cmd_depend "$@";;
  undepend)      [[ $# -eq 2 ]] || die "usage: fleet undepend <id> <dep-id>"; cmd_undepend "$@";;
  answer)        [[ $# -eq 2 ]] || die "usage: fleet answer <id> <n>"; cmd_answer "$1" "$2";;
  preview)       [[ $# -eq 3 ]] || die "usage: fleet preview <id> <port> <pid>"; cmd_preview "$@";;
  clear-preview) [[ $# -eq 1 ]] || die "usage: fleet clear-preview <id>"; cmd_clear_preview "$1";;
  log)           [[ $# -eq 2 ]] || die "usage: fleet log <id> \"<text>\""; cmd_log "$1" "$2";;
  archive)       [[ $# -eq 1 ]] || die "usage: fleet archive <id>"; cmd_archive "$1";;
  *) usage; [[ -n "$cmd" ]] && exit 1; exit 0;;
esac
