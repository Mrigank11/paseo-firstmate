# Sandbox environment: source this before any paseo / lavish-axi / bin/page call that must hit the
# sandbox instead of the live setup. Overrides are explicit so nothing falls through to ~/.paseo.
export PASEO_HOME="$HOME/.paseo-deck"
export PASEO_DECK_LISTEN="100.101.33.17:6777"
export LAVISH_AXI_PORT=4390
export LAVISH_AXI_STATE_DIR="$HOME/.paseo-deck/lavish"
